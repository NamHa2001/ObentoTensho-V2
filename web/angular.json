{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "customer": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/customer",
      "sourceRoot": "projects/customer/src",
      "prefix": "ot",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/customer/src/main.ts",
            "tsConfig": "projects/customer/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/customer/public"
              }
            ],
            "styles": [
              "node_modules/@fontsource/be-vietnam-pro/vietnamese-400.css",
              "node_modules/@fontsource/be-vietnam-pro/latin-ext-400.css",
              "node_modules/@fontsource/be-vietnam-pro/latin-400.css",
              "node_modules/@fontsource/be-vietnam-pro/vietnamese-500.css",
              "node_modules/@fontsource/be-vietnam-pro/latin-ext-500.css",
              "node_modules/@fontsource/be-vietnam-pro/latin-500.css",
              "node_modules/@fontsource/be-vietnam-pro/vietnamese-600.css",
              "node_modules/@fontsource/be-vietnam-pro/latin-ext-600.css",
              "node_modules/@fontsource/be-vietnam-pro/latin-600.css",
              "node_modules/@fontsource/be-vietnam-pro/vietnamese-700.css",
              "node_modules/@fontsource/be-vietnam-pro/latin-ext-700.css",
              "node_modules/@fontsource/be-vietnam-pro/latin-700.css",
              "node_modules/@fontsource/nunito/vietnamese-500.css",
              "node_modules/@fontsource/nunito/latin-ext-500.css",
              "node_modules/@fontsource/nunito/latin-500.css",
              "node_modules/@fontsource/nunito/vietnamese-600.css",
              "node_modules/@fontsource/nunito/latin-ext-600.css",
              "node_modules/@fontsource/nunito/latin-600.css",
              "projects/customer/src/styles.css"
            ],
            "server": "projects/customer/src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": ["localhost", "127.0.0.1"]
            },
            "ssr": {
              "entry": "projects/customer/src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "projects/customer/ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "pages": {
              "outputMode": "static",
              "ssr": false,
              "server": false
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "customer:build:production"
            },
            "development": {
              "buildTarget": "customer:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "proxy.conf.json"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
    "admin": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/admin",
      "sourceRoot": "projects/admin/src",
      "prefix": "ot",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/admin/src/main.ts",
            "tsConfig": "projects/admin/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/admin/public"
              }
            ],
            "styles": [
              "node_modules/@fontsource/be-vietnam-pro/vietnamese-400.css",
              "node_modules/@fontsource/be-vietnam-pro/latin-ext-400.css",
              "node_modules/@fontsource/be-vietnam-pro/latin-400.css",
              "node_modules/@fontsource/be-vietnam-pro/vietnamese-500.css",
              "node_modules/@fontsource/be-vietnam-pro/latin-ext-500.css",
              "node_modules/@fontsource/be-vietnam-pro/latin-500.css",
              "node_modules/@fontsource/be-vietnam-pro/vietnamese-600.css",
              "node_modules/@fontsource/be-vietnam-pro/latin-ext-600.css",
              "node_modules/@fontsource/be-vietnam-pro/latin-600.css",
              "node_modules/@fontsource/be-vietnam-pro/vietnamese-700.css",
              "node_modules/@fontsource/be-vietnam-pro/latin-ext-700.css",
              "node_modules/@fontsource/be-vietnam-pro/latin-700.css",
              "node_modules/@fontsource/nunito/vietnamese-800.css",
              "node_modules/@fontsource/nunito/latin-ext-800.css",
              "node_modules/@fontsource/nunito/latin-800.css",
              "projects/admin/src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4201,
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "admin:build:production"
            },
            "development": {
              "buildTarget": "admin:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}