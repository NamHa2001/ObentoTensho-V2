{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.csr.html",
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/api/**",
    "!/hubs/**",
    "!/uploads/**"
  ],
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/icons/**",
          "/media/**",
          "/**/*.(woff|woff2)"
        ]
      }
    }
  ]
}
