root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,html,scss,json,xlf,yml,yaml,md}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

# ASP.NET Core không có SynchronizationContext nên không cần ConfigureAwait(false)
dotnet_diagnostic.MA0004.severity = none
