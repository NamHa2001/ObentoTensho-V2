<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="HtmlSanitizer" />
    <PackageReference Include="MailKit" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Security\Resources\common-passwords.txt" LogicalName="ObentoTensho.Infrastructure.Security.Resources.common-passwords.txt" />
    <!-- WithCulture=false: đuôi .vi/.en/.ja là ngôn ngữ của mẫu, không để MSBuild tách thành assembly vệ tinh theo văn hóa -->
    <EmbeddedResource Include="Email\Templates\*.txt" LogicalName="EmailTemplates.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ObentoTensho.UnitTests" />
    <InternalsVisibleTo Include="ObentoTensho.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ObentoTensho.Contracts\ObentoTensho.Contracts.csproj" />
    <ProjectReference Include="..\ObentoTensho.Core\ObentoTensho.Core.csproj" />
  </ItemGroup>

</Project>
